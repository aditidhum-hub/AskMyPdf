{
  "name": "askmypdf-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "test:phase1": "tsx test/phase1.test.ts",
    "test:phase2": "tsx test/phase2.test.ts",
    "test:phase3": "tsx test/phase3.test.ts",
    "test:phase4": "tsx test/phase4.test.ts",
    "test:phase5": "tsx test/phase5.test.ts",
    "test": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}