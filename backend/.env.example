# Gemini AI API key (from Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# Secret for signing session tokens — MUST be changed in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASKMYPDF_JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Path to SQLite database (defaults to ./askmypdf.db)
ASKMYPDF_DB_PATH="./askmypdf.db"

# Allowed frontend URL for CORS (in production, set to your Vercel URL)
FRONTEND_URL="http://localhost:5173"

# Server port
PORT=3000
